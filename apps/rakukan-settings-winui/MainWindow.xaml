<Window
    x:Class="Rakukan.Settings.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Rakukan 設定">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <Style x:Key="SettingsPageLayout" TargetType="StackPanel">
                <Setter Property="Margin" Value="20,16,20,20" />
                <Setter Property="Spacing" Value="16" />
            </Style>
            <Style x:Key="SettingsPageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="FontSize" Value="24" />
            </Style>
            <Style x:Key="SettingsSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="FontSize" Value="18" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="0"
            Margin="20,16,20,0"
            IsOpen="False"
            IsClosable="True" />

        <NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            Margin="12,12,12,0"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="180"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="False"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.PaneFooter>
                <StackPanel Margin="12,8,12,16" Spacing="10">
                    <TextBlock
                        x:Name="VersionText"
                        FontSize="12"
                        Opacity="0.5" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Click="SaveButton_Click" Content="保存" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
                        <Button Grid.Column="1" Click="CloseButton_Click" Content="閉じる" HorizontalAlignment="Stretch" />
                    </Grid>
                </StackPanel>
            </NavigationView.PaneFooter>
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="General" Content="基本">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Appearance" Content="外観">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Font" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Input" Content="入力">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Keyboard" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Keys" Content="キー設定">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Pin" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Live" Content="ライブ変換">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Switch" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="UserDict" Content="ユーザー辞書">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Learning" Content="学習履歴">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Clock" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="AI" Content="AIモード"><NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Tag="Advanced" Content="補足">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Document" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <ScrollViewer x:Name="GeneralPage">
                    <StackPanel Style="{StaticResource SettingsPageLayout}">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SettingsPageTitle}" Text="基本設定" />
                            <TextBlock TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.7" Text="エンジンや候補表示に関する基本的な動作を設定します。" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="動作とモデル" />
                            <Grid ColumnSpacing="20" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                    <TextBlock Text="ログレベル" />
                                    <ComboBox x:Name="LogLevelCombo">
                                        <x:String>error</x:String>
                                        <x:String>warn</x:String>
                                        <x:String>info</x:String>
                                        <x:String>debug</x:String>
                                        <x:String>trace</x:String>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                                    <TextBlock Text="GPU バックエンド" />
                                    <ComboBox x:Name="GpuBackendCombo">
                                        <x:String>auto</x:String>
                                        <x:String>cpu</x:String>
                                        <x:String>vulkan</x:String>
                                        <x:String>cuda</x:String>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                                    <TextBlock Text="GPU レイヤー数" />
                                    <NumberBox x:Name="NGpuLayersBox" SmallChange="1" SpinButtonPlacementMode="Compact" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                    <TextBlock Text="使用 GPU インデックス" />
                                    <NumberBox x:Name="MainGpuBox" SmallChange="1" SpinButtonPlacementMode="Compact" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="6">
                                    <TextBlock Text="モデル ID" />
                                    <ComboBox x:Name="ModelVariantCombo" IsEditable="True" PlaceholderText="jinen-v1-xsmall-q5" SelectionChanged="ModelVariantCombo_SelectionChanged">
                                        <ComboBoxItem Content="jinen-v1-xsmall-q5   (約 30 MB)" Tag="jinen-v1-xsmall-q5" />
                                        <ComboBoxItem Content="jinen-v1-small-q5    (約 84 MB)" Tag="jinen-v1-small-q5" />
                                        <ComboBoxItem Content="jinen-v1-xsmall-f16  (約 138 MB)" Tag="jinen-v1-xsmall-f16" />
                                        <ComboBoxItem Content="jinen-v1-small-f16   (約 423 MB)" Tag="jinen-v1-small-f16" />
                                        <ComboBoxItem Content="jinen-v2-xsmall-q5   (約 28 MB)" Tag="jinen-v2-xsmall-q5" />
                                        <ComboBoxItem Content="jinen-v2-small-q5    (約 81 MB)" Tag="jinen-v2-small-q5" />
                                        <ComboBoxItem Content="jinen-v2-xsmall-f16  (約 72 MB)" Tag="jinen-v2-xsmall-f16" />
                                        <ComboBoxItem Content="jinen-v2-small-f16   (約 220 MB)" Tag="jinen-v2-small-f16" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="候補表示" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.7" Text="Space 変換で表示する候補数と、LLM 探索の上限を調整します。候補数を増やす場合は Space変換 beam も同じか大きい値にしてください。" />
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="候補数 (1-30)" />
                                    <NumberBox x:Name="NumCandidatesBox" SmallChange="1" Minimum="1" Maximum="30" SpinButtonPlacementMode="Inline" ValueChanged="NumCandidatesBox_ValueChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Space変換 beam (1-30)" />
                                    <NumberBox x:Name="ConversionBeamSizeBox" SmallChange="1" Minimum="1" Maximum="30" SpinButtonPlacementMode="Inline" ValueChanged="ConversionBeamSizeBox_ValueChanged" />
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="AppearancePage" Visibility="Collapsed">
                    <StackPanel Style="{StaticResource SettingsPageLayout}">
                        <TextBlock Style="{StaticResource SettingsPageTitle}" Text="外観" />
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="候補の文字サイズ" />
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="フォントサイズ (10-72)" />
                                    <NumberBox x:Name="CandidateFontHeightBox" SmallChange="1" Minimum="10" Maximum="72" SpinButtonPlacementMode="Inline" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Bottom">
                                    <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="100% 表示時のサイズです。Windows の拡大率に合わせて文字・行間・余白を拡大します。次回の候補表示から反映。" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="入力位置のキャレット" />
                            <Grid ColumnSpacing="16" MinHeight="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="IME のオン／オフで太さを変える" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="CaretWidthEnabledToggle" Grid.Column="1" MinWidth="44" OnContent="" OffContent="" AutomationProperties.Name="IME のオン／オフで太さを変える" />
                            </Grid>
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="IME オン時の太さ (1–20)" />
                                    <NumberBox x:Name="CaretOnWidthBox" Minimum="1" Maximum="20" SmallChange="1" SpinButtonPlacementMode="Inline" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="IME オフ時の太さ (1–20)" />
                                    <NumberBox x:Name="CaretOffWidthBox" Minimum="1" Maximum="20" SmallChange="1" SpinButtonPlacementMode="Inline" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="Windows のテキストカーソルの太さを切り替えます。無効にすると元の設定に戻ります。独自描画のアプリでは反映されない場合や、入力欄を選び直す必要がある場合があります。" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="InputPage" Visibility="Collapsed">
                    <StackPanel Style="{StaticResource SettingsPageLayout}">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SettingsPageTitle}" Text="入力設定" />
                            <TextBlock TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.7" Text="キーボード配列と入力モードの初期状態を調整します。" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="キーボード" />
                            <StackPanel Spacing="6">
                                <TextBlock Text="キーボード配列" />
                                <ComboBox x:Name="KeyboardLayoutCombo">
                                    <x:String>jis</x:String>
                                    <x:String>us</x:String>
                                    <x:String>custom</x:String>
                                </ComboBox>
                            </StackPanel>
                            <Grid ColumnSpacing="16" MinHeight="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="入力モード切替時に config.toml を再読込する" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="ReloadOnModeSwitchToggle" Grid.Column="1" MinWidth="44" OnContent="" OffContent="" AutomationProperties.Name="入力モード切替時に config.toml を再読込する" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="入力モード" />
                            <Grid ColumnSpacing="20" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="起動時の IME 状態" />
                                    <ComboBox x:Name="DefaultModeCombo">
                                        <x:String>off</x:String>
                                        <x:String>on</x:String>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="数字の入力幅" />
                                    <ComboBox x:Name="DigitWidthCombo">
                                        <x:String>halfwidth</x:String>
                                        <x:String>fullwidth</x:String>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="英字の入力幅" />
                                    <ComboBox x:Name="AlphaWidthCombo">
                                        <x:String>fullwidth</x:String>
                                        <x:String>halfwidth</x:String>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="記号の入力幅" />
                                    <ComboBox x:Name="SymbolWidthCombo">
                                        <x:String>fullwidth</x:String>
                                        <x:String>halfwidth</x:String>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="16" MinHeight="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="前回の IME オン/オフをアプリごとに記憶する" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="RememberKanaModeToggle" Grid.Column="1" MinWidth="44" OnContent="" OffContent="" AutomationProperties.Name="前回の IME オン/オフをアプリごとに記憶する" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="学習" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.7" Text="変換を確定するたびに、選択した候補を次回以降の優先順位に反映します。" />
                            <Grid ColumnSpacing="16" MinHeight="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="変換確定時に学習する" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="学習履歴へ" Click="OpenLearning_Click" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="LearningPage" Visibility="Collapsed" Margin="20,16,20,20" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SettingsPageTitle}" Text="学習履歴" />
                            <TextBlock Text="使いたい表記を、自分に合わせる。" Opacity="0.7" />
                        </StackPanel>
                        <Button x:Name="LearningReloadButton" Grid.Column="1" Content="再読み込み" Click="LearningReload_Click" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="変換確定時に学習する" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="AutoLearnToggle" Grid.Column="1" MinWidth="44" OnContent="" OffContent="" AutomationProperties.Name="変換確定時に学習する" />
                    </Grid>
                    <TextBox x:Name="LearningSearch" Grid.Row="2" PlaceholderText="読み・表記で検索（例：あるの）" TextChanged="LearningSearch_TextChanged" AutomationProperties.Name="学習履歴を検索" />
                    <StackPanel x:Name="LearningToolbar" Grid.Row="3" Orientation="Horizontal" Spacing="6">
                        <Button Content="追加" Click="LearningAdd_Click" />
                        <Button x:Name="LearningEditButton" Content="編集" Click="LearningEdit_Click" IsEnabled="False" />
                        <Button x:Name="LearningPreferButton" Content="優先する" Click="LearningPrefer_Click" IsEnabled="False" />
                        <Button x:Name="LearningDeleteButton" Content="削除" Click="LearningDelete_Click" IsEnabled="False" />
                    </StackPanel>
                    <InfoBar x:Name="LearningStatus" Grid.Row="4" IsOpen="False" IsClosable="True" />
                    <Grid Grid.Row="5">
                        <ListView x:Name="LearningList" SelectionMode="Single" SelectionChanged="LearningList_SelectionChanged" DoubleTapped="LearningList_DoubleTapped" HorizontalContentAlignment="Stretch" AutomationProperties.Name="学習候補の一覧">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Surface}" FontSize="16" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Reading}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding LastUsed}" FontSize="12" Opacity="0.6" VerticalAlignment="Center" ToolTipService.ToolTip="最終使用日時" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="LearningEmpty" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.65" IsHitTestVisible="False" />
                        <ProgressRing x:Name="LearningProgress" IsActive="False" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                    <StackPanel Grid.Row="6" Spacing="4">
                        <TextBlock x:Name="LearningCount" FontSize="12" Opacity="0.65" />
                        <TextBlock Text="履歴の編集はすぐ反映されます。自動学習の切替は「保存して閉じる」で保存します。" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="KeysPage" Visibility="Collapsed">
                    <StackPanel Style="{StaticResource SettingsPageLayout}">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SettingsPageTitle}" Text="キー設定" />
                            <TextBlock TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.7" Text="主要ショートカットはここで直接入力できます。例: Ctrl+Space, Henkan, Zenkaku" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="プリセット" />
                            <StackPanel Spacing="6">
                                <TextBlock Text="キーバインドプリセット" />
                                <ComboBox x:Name="KeymapPresetCombo" SelectionChanged="KeymapPresetCombo_SelectionChanged">
                                    <x:String>ms-ime-jis</x:String>
                                    <x:String>ms-ime-us</x:String>
                                    <x:String>custom</x:String>
                                </ComboBox>
                            </StackPanel>
                            <Grid ColumnSpacing="16" MinHeight="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="プリセットをベースに主要ショートカットを上書きする" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="KeymapInheritToggle" Toggled="KeymapInheritToggle_Toggled" Grid.Column="1" MinWidth="44" OnContent="" OffContent="" AutomationProperties.Name="プリセットをベースに主要ショートカットを上書きする" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="14">
                            <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="主要ショートカット" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock TextWrapping="Wrap" Opacity="0.7" VerticalAlignment="Center" Text="対応するキー名を直接入力してください。例: Ctrl+Space, Henkan, Zenkaku" />
                                <Button Grid.Column="1" VerticalAlignment="Center" Content="キー名の一覧と注意" Padding="10,4">
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">
                                            <!-- FlyoutPresenter の既定 MaxWidth は 456px で等幅の一覧が切れるため広げる -->
                                            <Flyout.FlyoutPresenterStyle>
                                                <Style TargetType="FlyoutPresenter">
                                                    <Setter Property="MaxWidth" Value="820" />
                                                    <Setter Property="MaxHeight" Value="640" />
                                                    <Setter Property="Padding" Value="16" />
                                                </Style>
                                            </Flyout.FlyoutPresenterStyle>
                                            <ScrollViewer MaxHeight="600" Width="760" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                <StackPanel Spacing="10" Padding="4">
                                                    <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="使えるキー名" />
                                                    <TextBlock TextWrapping="Wrap" Text="大文字小文字は区別しません。修飾キーは「+」でつなげます（例: Ctrl+Space, Shift+Tab, RAlt+Caps）。" />
                                                    <TextBlock IsTextSelectionEnabled="True" FontFamily="Consolas" TextWrapping="Wrap" Text="修飾キー  : Ctrl(Control), Shift, Alt  … 左右どちらでも一致&#x0a;            LCtrl, RCtrl, LShift, RShift, LAlt, RAlt  … 左右を区別&#x0a;基本      : Backspace(BS), Tab, Enter(Return), Escape(Esc), Space, Delete(Del)&#x0a;移動      : Left, Right, Up, Down, Home, End, PageUp(PgUp), PageDown(PgDn)&#x0a;ファンクション: F1 〜 F12&#x0a;記号      : Backquote(Grave), Semicolon, Equal, Comma, Minus, Period, Slash,&#x0a;            LeftBracket, Backslash, RightBracket, Quote&#x0a;日本語キー: Zenkaku(Hankaku, Kanji), Henkan, Muhenkan, Eisuu(Alphanumeric),&#x0a;            Katakana, Hiragana_key, Caps&#x0a;英字      : A 〜 Z の 1 文字" />
                                                    <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="注意" />
                                                    <TextBlock TextWrapping="Wrap" Text="• 数字キー 0〜9 は候補選択に使うため割り当てできません。" />
                                                    <TextBlock TextWrapping="Wrap" Text="• Insert, PrintScreen, ScrollLock, Pause, Apps, F13 以降, テンキー, メディアキー, Win キーは使えません。" />
                                                    <TextBlock TextWrapping="Wrap" Text="• 修飾キー単独（Ctrl だけ等）は割り当てできません。修飾キーなしの英字 1 文字は書式上通りますが、その文字の入力を上書きします。" />
                                                    <TextBlock TextWrapping="Wrap" Text="• 左右指定（LCtrl 等）と汎用指定（Ctrl）の両方に同じキーがあるときは、左右指定が優先されます。" />
                                                    <TextBlock TextWrapping="Wrap" Text="• 日本語キー（Zenkaku, Henkan, Muhenkan, Eisuu, Katakana, Hiragana_key）は日本語キーボードでのみ使えます。" />
                                                    <TextBlock TextWrapping="Wrap" Text="• Alt+Tab や Win キーの組み合わせなど Windows が先に処理するキー、ブラウザの Ctrl+L のようにアプリが IME より先に処理するキーは、設定しても効きません。" />
                                                    <TextBlock TextWrapping="Wrap" Text="• 一つのアクションに複数のキーを割り当てたい場合や、ここに無いアクションは「詳細編集」から keymap.toml を編集してください。" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>

                            <Grid ColumnSpacing="10" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="IME 切替" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="ImeToggleBox" PlaceholderText="Ctrl+Space / Zenkaku" />
                                <Button Grid.Row="0" Grid.Column="2" Tag="ImeToggle" Click="ClearKeyButton_Click" Content="解除" />

                                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="IME ON" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="ImeOnBox" PlaceholderText="Hiragana_key / Ctrl+J" />
                                <Button Grid.Row="1" Grid.Column="2" Tag="ImeOn" Click="ClearKeyButton_Click" Content="解除" />

                                <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="IME OFF" />
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="ImeOffBox" PlaceholderText="Eisuu / Ctrl+L" />
                                <Button Grid.Row="2" Grid.Column="2" Tag="ImeOff" Click="ClearKeyButton_Click" Content="解除" />

                                <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="変換開始" />
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="ConvertBox" PlaceholderText="Space / Henkan" />
                                <Button Grid.Row="3" Grid.Column="2" Tag="Convert" Click="ClearKeyButton_Click" Content="解除" />

                                <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="ひらがな確定" />
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="CommitRawBox" PlaceholderText="Enter" />
                                <Button Grid.Row="4" Grid.Column="2" Tag="CommitRaw" Click="ClearKeyButton_Click" Content="解除" />

                                <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="取消" />
                                <TextBox Grid.Row="5" Grid.Column="1" x:Name="CancelBox" PlaceholderText="Escape" />
                                <Button Grid.Row="5" Grid.Column="2" Tag="Cancel" Click="ClearKeyButton_Click" Content="解除" />

                                <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="全取消" />
                                <TextBox Grid.Row="6" Grid.Column="1" x:Name="CancelAllBox" PlaceholderText="Ctrl+Backspace" />
                                <Button Grid.Row="6" Grid.Column="2" Tag="CancelAll" Click="ClearKeyButton_Click" Content="解除" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="詳細編集" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.7" Text="複数キーの割り当てや未表示のアクションは keymap.toml から調整できます。" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="keymap.toml を開く" Click="OpenKeymapButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="LivePage" Visibility="Collapsed">
                    <StackPanel Style="{StaticResource SettingsPageLayout}">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SettingsPageTitle}" Text="ライブ変換" />
                            <TextBlock TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.7" Text="ライブ変換の反応速度と候補生成の方針を設定します。" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="16" MinHeight="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ライブ変換を有効にする" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="LiveEnabledToggle" Grid.Column="1" MinWidth="44" OnContent="" OffContent="" AutomationProperties.Name="ライブ変換を有効にする" />
                            </Grid>
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="デバウンス (ms)" />
                                    <NumberBox x:Name="DebounceMsBox" SmallChange="10" SpinButtonPlacementMode="Compact" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="beam_size (1-9)" />
                                    <NumberBox x:Name="BeamSizeBox" SmallChange="1" Minimum="1" Maximum="9" SpinButtonPlacementMode="Compact" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Text="開始文字数 (1-9)" />
                                    <NumberBox x:Name="MinCharsBox" SmallChange="1" Minimum="1" Maximum="9" SpinButtonPlacementMode="Compact" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="16" MinHeight="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="LLM をライブ変換に使う" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="UseLlmToggle" Grid.Column="1" MinWidth="44" OnContent="" OffContent="" AutomationProperties.Name="LLM をライブ変換に使う" />
                            </Grid>
                            <Grid ColumnSpacing="16" MinHeight="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="辞書候補を優先してから LLM 候補を使う" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="PreferDictionaryFirstToggle" Grid.Column="1" MinWidth="44" OnContent="" OffContent="" AutomationProperties.Name="辞書候補を優先してから LLM 候補を使う" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="UserDictPage" Visibility="Collapsed">
                    <StackPanel Style="{StaticResource SettingsPageLayout}">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SettingsPageTitle}" Text="ユーザー辞書" />
                            <TextBlock TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.7" Text="読み (ひらがな) に対応する変換候補を登録します。登録語は他候補より優先されます。" />
                        </StackPanel>

                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="追加" Click="UserDictAddButton_Click" />
                                <Button Content="編集" Click="UserDictEditButton_Click" />
                                <Button Content="削除" Click="UserDictDeleteButton_Click" />
                                <AppBarSeparator />
                                <Button Content="user_dict.toml を開く" Click="OpenUserDictButton_Click" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="インポート…" Click="UserDictImportButton_Click" />
                                <Button Content="エクスポート…" Click="UserDictExportButton_Click" />
                            </StackPanel>
                            <TextBlock Text="タブ区切りの辞書（読み・単語・品詞・コメント）に対応。インポートは既存の辞書に追加し、保存時に反映します。エクスポートには編集中の項目も含まれます。" TextWrapping="Wrap" Opacity="0.7" />
                            <Grid ColumnSpacing="12" Padding="12,8,12,8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="読み" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="変換候補（先頭優先）" FontWeight="SemiBold" />
                            </Grid>
                            <ListView
                                x:Name="UserDictList"
                                MinHeight="160"
                                SelectionMode="Single"
                                DoubleTapped="UserDictList_DoubleTapped">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Reading}" />
                                            <TextBlock Grid.Column="1" Text="{Binding SurfacesJoined}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="AdvancedPage" Visibility="Collapsed">
                    <StackPanel Style="{StaticResource SettingsPageLayout}">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SettingsPageTitle}" Text="補足" />
                            <TextBlock TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.7" Text="設定ファイルを直接開いたり、反映タイミングを確認できます。" />
                        </StackPanel>

                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="設定ファイル" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.7" Text="保存時または画面を閉じたときに、現在の IME へ反映します。" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="config.toml を開く" Click="OpenConfigButton_Click" />
                                <Button Content="keymap.toml を開く" Click="OpenKeymapButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="AiPage" Visibility="Collapsed">
                    <StackPanel Style="{StaticResource SettingsPageLayout}">
                        <TextBlock Style="{StaticResource SettingsPageTitle}" Text="AIモード" />
                        <ToggleSwitch x:Name="AiEnabled" Header="AIモードを使う（すぐに反映）" Toggled="AiEnabled_Toggled" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ToggleButton x:Name="AiConnectionTab" Content="接続" Tag="connection" IsChecked="True" Click="AiSection_Click" />
                            <ToggleButton x:Name="AiCommandsTab" Content="コマンド" Tag="commands" Click="AiSection_Click" />
                            <ToggleButton x:Name="AiTestTab" Content="動作確認" Tag="test" Click="AiSection_Click" />
                        </StackPanel>
                        <StackPanel x:Name="AiConnectionSection" Spacing="12">
                        <TextBox x:Name="AiKey" Header="AIキー" PlaceholderText="Henkan / F10 / Ctrl+Shift+A" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.7" Text="有効時はAIキーを優先します。Henkanに割り当てたIME ON・再変換は使えなくなります。IME ONはひらがなキー等、再変換はCtrl+Shift+Rを使えます。" />
                        <TextBlock TextWrapping="Wrap" Text="Enter：生成／指示追加がなければ採用　Tab：別候補　Esc：取消。文字入力で結果を不採用にして補正指示を入力します。" />
                        <ComboBox x:Name="AiBackendCombo" Header="モデル接続" HorizontalAlignment="Stretch" SelectionChanged="AiBackend_Changed">
                            <ComboBoxItem Tag="copilot" Content="Copilot Keyboard の起動中モデルを共有" />
                            <ComboBoxItem Tag="local" Content="ローカル GGUF（llama-server）" />
                            <ComboBoxItem Tag="remote" Content="外部 OpenAI互換サーバー" />
                        </ComboBox>
                        <TextBlock x:Name="AiCopilotNote" TextWrapping="Wrap" Opacity="0.7" Text="Copilot Keyboardを起動してモデルを有効にしてください。内部通信方式を使用するため、更新後は動作確認してください。接続失敗時に別モデルへ切り替えることはありません。" />
                        <StackPanel x:Name="AiLocalFields" Spacing="8" Visibility="Collapsed">
                            <TextBox x:Name="AiServerPath" Header="llama-server.exe のパス" />
                            <Button Content="サーバーを選択…" Tag="server" Click="AiBrowse_Click" />
                            <TextBox x:Name="AiModelPath" Header="GGUFモデルのパス" />
                            <Button Content="モデルを選択…" Tag="model" Click="AiBrowse_Click" />
                            <NumberBox x:Name="AiPort" Header="ローカルポート" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="起動・確認" Click="AiConnect_Click" />
                                <Button Content="停止" Click="AiStop_Click" />
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Opacity="0.7" Text="初回の生成時にも自動起動します。モデルのダウンロードは行いません。待機中はモデルを保持します。" />
                        </StackPanel>
                        <StackPanel x:Name="AiRemoteFields" Spacing="8" Visibility="Collapsed">
                            <TextBox x:Name="AiUrl" Header="URL（ポートと /v1 を含む）" PlaceholderText="http://gpu-server:8080/v1" />
                            <PasswordBox x:Name="AiApiKey" Header="API認証キー（必要な場合）" />
                        </StackPanel>
                        <TextBox x:Name="AiModelName" Header="サーバーのモデル名（外部／ローカル）" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <NumberBox x:Name="AiTimeout" Header="待機上限（秒）" Minimum="5" Maximum="600" />
                            <NumberBox x:Name="AiMaxTokens" Grid.Column="1" Header="生成上限トークン" Minimum="16" Maximum="4096" />
                        </Grid>
                        </StackPanel>
                        <StackPanel x:Name="AiCommandsSection" Spacing="12" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="コマンド" />
                        <ComboBox x:Name="AiCommands" DisplayMemberPath="Name" HorizontalAlignment="Stretch" SelectionChanged="AiCommand_Changed" />
                        <TextBox x:Name="AiCommandName" Header="名前" />
                        <TextBox x:Name="AiAliases" Header="別名（カンマ区切り）" />
                        <TextBox x:Name="AiPrompt" Header="モデルへの指示" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="160" />
                        <ComboBox x:Name="AiCommandLanguage" Header="出力言語" HorizontalAlignment="Stretch">
                            <ComboBoxItem Tag="japanese" Content="日本語" /><ComboBoxItem Tag="english" Content="英語" /><ComboBoxItem Tag="chinese" Content="中国語" /><ComboBoxItem Tag="korean" Content="韓国語" /><ComboBoxItem Tag="french" Content="フランス語" /><ComboBoxItem Tag="german" Content="ドイツ語" /><ComboBoxItem Tag="spanish" Content="スペイン語" />
                        </ComboBox>
                        <CheckBox x:Name="AiAppend" Content="元の文章の末尾に追加する（オフなら置換）" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="追加" Click="AiAddCommand_Click" />
                            <Button Content="削除" Click="AiDeleteCommand_Click" />
                        </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="AiTestSection" Spacing="12" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="動作確認" />
                        <TextBox x:Name="AiTestText" Header="テスト文章" Text="今日は晴れです。" TextWrapping="Wrap" AcceptsReturn="True" />
                        <TextBox x:Name="AiTestInstruction" Header="指示（空欄なら続きを生成）" Text="えいご" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="AiConnectButton" Content="接続確認" Click="AiConnect_Click" />
                            <Button x:Name="AiGenerateButton" Content="生成を試す" Click="AiGenerate_Click" />
                            <Button Content="中止" Click="AiCancel_Click" />
                            <ProgressRing x:Name="AiProgress" Width="24" Height="24" IsActive="False" />
                        </StackPanel>
                        <TextBlock x:Name="AiTestStatus" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBox x:Name="AiTestOutput" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="200" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>

    </Grid>
</Window>
